{
  "config": {
    "DatapackName": "VanillaPerms",
    "Abbreviation": "VP",
    "Description": "Vanilla-native permissions system inspired by LuckPerms",
    "BaseTrigger": "vp",
    "SubBase": ["permissions", "perms", "rank", "permsA"],
    "DefaultFlags": {
      "AllowExecute": true,
      "AllowExecuteForOthers": false,
      "AllowSelectors": false,
      "AllowFunctionCall": false,
      "AllowTriggerUse": true,
      "AllowSubcommandOverride": false,
      "AllowAliasUse": true,
      "EnforceSingleTrigger": true,
      "RequireOperatorLevel": 3,
      "AllowNestedFunctionCall": true,
      "AllowBulkPermissionAdd": true,
      "AllowBulkPermissionRemove": true,
      "AllowBulkFlagEdit": true,
      "AllowTempPermission": false,
      "AllowTempGroup": false,
      "ChatRank": true,
      "TabRank": true,
      "PlayerRank": false,
      "OverrideDisplayName": false,
      "HideFromVP": false,
      "ForceChatPrefix": false,
      "ForceChatSuffix": false,
      "ForceTabPrefix": false,
      "ForceTabSuffix": false,
      "UseCustomRankName": false,
      "HideDefaultRankName": false,
      "AllowSeparateTabChatRanks": false,
      "AutoUpdateDisplay": true,
      "DisplayDebugInfo": false,
      "RankHoverInfo": false,
      "AllowCreateGroup": false,
      "AllowDeleteGroup": false,
      "AllowEditGroup": false,
      "AllowAssignGroup": false,
      "AllowRemoveGroup": false,
      "AllowReloadVP": false,
      "AllowGroupInheritance": true,
      "AllowGroupPriority": true,
      "AllowOverrideFlags": true,
      "MaintenanceMode": false,
      "DebugMode": false,
      "SafeMode": true,
      "AutoRecalculateOnJoin": true,
      "AutoRecalculateOnReload": true,
      "EnforceDefaultGroup": true,
      "AllowWildcardPermission": true,
      "AllowNegativePermission": true,
      "EnforcePermissionOrder": true,
      "AllowCustomContexts": false,
      "EnablePermissionCache": true,
      "RecalculateOnFlagChange": true,
      "PreventOperatorOverride": true,
      "EnableAliasValidation": true,
      "RequireConfirmation": true,
      "AllowCommandLogging": true
    }
  }
} 