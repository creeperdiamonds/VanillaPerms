# vp:zz_util_player_found_get_group.mcfunction
# Callback for when the find_player loop is used to get a player's group name.

# The player object we want is at the top of the 'find_player_temp' list.
# Copy their group name to the designated temp storage location.
data modify storage vp:temp current_player_group set from storage vp:temp find_player_temp[0].group

































































































































# Clean up the find_player_temp list, as we are done with it for this process.
data remove storage vp:temp find_player_temp
